{
  "name": "opencode-guardian",
  "version": "0.1.1",
  "description": "Universal quality and safety guardian plugin for OpenCode AI agents (Dual-Mode: OpenCode v1 & v2)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "index.js",
    "server.js"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-guardian",
    "guardian",
    "guard",
    "linter",
    "code-quality",
    "safety",
    "guardrails"
  ],
  "author": "Hüseyin Hadi Çığ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/opencode-guard.git"
  },
  "bugs": {
    "url": "https://github.com/huseyincig/opencode-guard/issues"
  },
  "homepage": "https://github.com/huseyincig/opencode-guard#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
