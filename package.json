{
  "name": "opencode-guardian",
  "version": "0.4.1",
  "description": "Universal quality and safety guardian plugin for OpenCode AI agents (Dual-Mode: OpenCode v1 & v2)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "index.js",
    "server.js",
    "scripts/guardian-status.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-guardian",
    "guardian",
    "guard",
    "linter",
    "code-quality",
    "safety",
    "guardrails"
  ],
  "author": "Hüseyin Hadi Çığ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/opencode-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/huseyincig/opencode-guardian/issues"
  },
  "homepage": "https://github.com/huseyincig/opencode-guardian#readme",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode/plugin": "^2.0.21",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.0"
  },
  "bin": {
    "opencode-guardian-status": "./scripts/guardian-status.mjs"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@babel/core": "^7.29.7"
  }
}
